# .env.voip.example — adicionar estas chaves ao .env / .env.hostgator existente

# ---------- Asterisk / ARI ----------
ARI_URL=http://asterisk:8088
ARI_WS_URL=ws://asterisk:8088/ari/events
ARI_USERNAME=voice-agent-user
ARI_PASSWORD=TROCAR_SENHA_FORTE          # igual ao definido em asterisk/ari.conf
ARI_APP=voice-agent

# ---------- Trunk SIP (seu provedor) ----------
VOIP_TRUNK_ENDPOINT=PJSIP/trunk-endpoint  # nome do endpoint definido em pjsip.conf
VOIP_DEFAULT_CALLER_ID=+5551999998888     # número mostrado em chamadas de saída
# Com mais de uma organização na instalação, o tronco acima só é usado por quem
# não tem tronco próprio se o operador ligar isto (senão cada empresa cadastra o
# dela em Configurações > Trunk SIP). Instalação de uma empresa só: não precisa.
VOIP_TRUNK_COMPARTILHADO=desligado

# ---------- OpenAI Realtime (voz-a-voz) ----------
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime

# ---------- Supabase (service-role, já deve existir no .env principal) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
