  "design_tokens": {
    "typography": {
      "font_family": "Inter, Plus Jakarta Sans, or system-ui, sans-serif",
      "weights": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700
      }
    },
    "layout_metrics": {
      "card_border_radius": "16px",
      "button_border_radius": "10px",
      "sidebar_width": "240px",
      "grid_gap": "16px"
